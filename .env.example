# ------------------------------------------------------------------
# UP_Post — variables d'environnement
# Copiez ce fichier vers `.env` puis renseignez vos valeurs.
# NE JAMAIS commiter le fichier `.env` (il est ignoré par .gitignore).
# Les valeurs ci-dessous sont des gabarits : remplacez-les, ne les
# laissez telles quelles.
# ------------------------------------------------------------------

# --- Base de données (Prisma / PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="<postgresql://user:password@localhost:5432/up_post?schema=public>"

# --- Authentification (Clerk) ---
# Obtenu sur https://dashboard.clerk.com  (Settings -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="<cle-publique-clerk>"
CLERK_SECRET_KEY="<cle-secrete-clerk>"

# --- Connecteurs Facebook / Instagram ---
# Tokens d'accès LONG VIVANTS obtenus via le flux OAuth de votre app Meta.
# Utilisés par src/components/add_page_model.tsx (boutons "Facebook" / "Instagram").
# Ces valeurs doivent être fournies par l'environnement, jamais écrites en dur.
NEXT_PUBLIC_FB_USER_TOKEN_FB="<token-page-facebook>"
NEXT_PUBLIC_FB_USER_TOKEN_IG="<token-page-instagram>"
